# Base URLs for the demos deploy (served at demo.buildlocal.agency).
# These are NEXT_PUBLIC_* (compile-time, public) — safe to commit, no secrets here.
# They drive the CRM's on-screen QR targets, the "Site" links, and Slack ping URLs.
NEXT_PUBLIC_PUBLISHED_BASE=https://demo.buildlocal.agency
NEXT_PUBLIC_SCAN_BASE=https://demo.buildlocal.agency
NEXT_PUBLIC_LOCAL_BASE=https://demo.buildlocal.agency
